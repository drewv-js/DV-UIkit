{
  "name": "@dv-uikit/react",
  "version": "0.1.0",
  "private": true,
  "description": "DV React wrapper package.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); fs.rmSync('dist',{recursive:true,force:true});\"",
    "build": "npm run clean && npm run build:copy",
    "build:copy": "node -e \"const fs=require('node:fs'); fs.mkdirSync('dist',{recursive:true}); fs.copyFileSync('../core/dist/react.js','dist/index.js'); fs.copyFileSync('../core/dist/react.d.ts','dist/index.d.ts');\"",
    "lint": "npm run typecheck",
    "test": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dv-uikit/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
